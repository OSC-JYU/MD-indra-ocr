# Must match the backend's SERVICE_TOKEN (MessyDesk/local/.env). Only needed if it is not the
# default of MessyDesk/local/.env.example.
# SERVICE_TOKEN=change-me-too

# Defaults fit MessyDesk/local started as the compose project "messydesk"
# MD_URL=http://backend:8200
# MESSYDESK_NETWORK=messydesk_default
# MESSYDESK_DATA_VOLUME=messydesk_md-data

# Where MD-consumers is checked out (only used if the md-consumer image is not built yet)
# MD_CONSUMERS_DIR=../MD-consumers

# ONNX Runtime threads used for OCR
# INDRA_THREADS=4
